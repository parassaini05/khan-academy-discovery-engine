# Khan Academy AI Discovery Engine & Learner Intelligence Platform
# Copy this file to .env and insert your API keys

# Groq Cloud API Key (Get at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Apify API Token (Optional, for re-crawling Reddit or YouTube data)
APIFY_TOKEN=apify_api_your_apify_token_here

# Google OAuth Credentials (Optional, if using Google Workspace integration)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
